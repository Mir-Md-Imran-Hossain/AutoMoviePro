# AutoMovie Pro — environment template (placeholders only)
# Copy to .env and fill values. Never commit real secrets.

API_BASE_URL=https://automoviepro.com
LOCAL_HOST=127.0.0.1
LOCAL_PORT=8787
SHORT_MAX_SECONDS=120
LONG_MAX_SECONDS=300
INTELLIGENCE_MODE=PRODUCTION
INTELLIGENCE_RESEARCH_MODE=LIVE
# true = simulate upload (safe default); false = real YouTube/Facebook upload
DRY_RUN_PUBLISH=true

# Local/offline login — FAIL CLOSED in production (default false).
# PRODUCTION requires AMP_ALLOW_LOCAL_LOGIN=true AND both credentials set.
# DEVELOPMENT may use demo defaults only when AMP_ALLOW_LOCAL_LOGIN=true.
AMP_ALLOW_LOCAL_LOGIN=false
AMP_DEV_LOGIN_ID=
AMP_DEV_LOGIN_PASSWORD=
# Optional comma list; defaults to local/localhost/offline/127.0.0.1 only (no marketing domains)
# AMP_LOCAL_LOGIN_BASES=local,localhost,offline,http://127.0.0.1,http://localhost

# Optional extra .env paths (os.pathsep-separated). Do not use machine-specific hardcoded roots.
# AMP_EXTRA_ENV_PATHS=

# --- Dedicated per-task API slots (preferred) ---
# Agent (1) + Topic Grok (2) — xAI keys preferred; OpenRouter Grok keys also OK
AGENT_GROK_API_KEY_1=
TOPIC_GROK_API_KEY_1=
TOPIC_GROK_API_KEY_2=

# Image generation Google (optional; 1 works, 2 = fallback). Empty → skip Google image + notify.
IMAGE_GOOGLE_API_KEY_1=
IMAGE_GOOGLE_API_KEY_2=

# Localization Google (2 required)
LOCALIZATION_GOOGLE_API_KEY_1=
LOCALIZATION_GOOGLE_API_KEY_2=

# TTS Google — only for unlocked bn/ta/ml (Edge langs en/hi/ur need none)
GOOGLE_API_KEY_BN_PRIMARY=
GOOGLE_API_KEY_BN_SECONDARY=
GOOGLE_API_KEY_TA_PRIMARY=
GOOGLE_API_KEY_TA_SECONDARY=
GOOGLE_API_KEY_ML_PRIMARY=
GOOGLE_API_KEY_ML_SECONDARY=

# Cloudflare Workers AI (Pollinations fallback)
# Pair each token with its account: Account_ID_N or WorkersAI_ACCOUNT_ID_N
WorkersAI_ACCOUNT_ID=
CLOUDFLARE_ACCOUNT_ID=
WorkersAI_API_KEY_1=
Account_ID_1=
WorkersAI_API_KEY_2=
Account_ID_2=
# WorkersAI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# WorkersAI_FLUX_STEPS=0

# Google AI / YouTube (numbered keys supported — general pool / legacy)
GOOGLE_API_KEY_1=
GOOGLE_API_KEY_2=
GOOGLE_CREDENTIALS_FILE_1=
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_API_SCOPES=

# Dedicated localization Google keys (preferred). One key is pinned per language/session.
# If empty, system falls back to GOOGLE_API_KEY_* pool with the same pinning rules.
LOCALIZATION_GOOGLE_API_KEY_1=
LOCALIZATION_GOOGLE_API_KEY_2=
LOCALIZATION_GOOGLE_API_KEY_3=
LOCALIZATION_GOOGLE_API_KEY_4=
LOCALIZATION_GOOGLE_API_KEY_5=
# Dedicated Gemini TTS keys (preferred). One key is pinned per language/session.
# If empty, system falls back to GOOGLE_API_KEY_* pool with the same pinning rules.
TTS_GOOGLE_API_KEY_1=
TTS_GOOGLE_API_KEY_2=
TTS_GOOGLE_API_KEY_3=
TTS_GOOGLE_API_KEY_4=
TTS_GOOGLE_API_KEY_5=

# --- TTS Engine Allocation Matrix (custom pipeline) ---
# en/hi/ur → ALWAYS Edge-TTS (no Google). bn/ta/ml → Google dual-key + Edge fallback.
# Dedicated dual keys per high-accuracy language (preferred):
GOOGLE_API_KEY_BN_PRIMARY=
GOOGLE_API_KEY_BN_SECONDARY=
GOOGLE_API_KEY_TA_PRIMARY=
GOOGLE_API_KEY_TA_SECONDARY=
GOOGLE_API_KEY_ML_PRIMARY=
GOOGLE_API_KEY_ML_SECONDARY=
# Aliases also accepted: TTS_GOOGLE_API_KEY_BN_PRIMARY, ENV_BN_PRIMARY_KEY, etc.
# Soft switch at 90%, hard block at 95%. Override:
# AMP_API_ROTATE_AT=0.90
# AMP_API_HARD_CAP=0.95
# CUSTOM_PIPELINE_TTS_MODEL=gemini-2.5-flash-preview-tts
# --- Visual continuity / quality ---
# auto | images_only | video_only | prefer_stock_video
# AMP_MEDIA_VISUAL_MODE=auto
# Still frames per IMAGE shot (1–3). Empty = auto from duration (2 if ≥4.5s, 3 if ≥8s)
# AMP_IMAGE_FRAMES_PER_SHOT=2
# AV match: max local regenerations after gate fail (0–2). Default 1 — thrift.
# AMP_AV_MAX_REGEN=1
# Vision critic: auto (only when local gate fails) | off | on
# AMP_AV_VISION_CRITIC=auto
# AMP_AV_VISION_MAX_PER_PKG=4
# AMP_AV_VISION_MODEL=gemini-2.0-flash
# Fixed package seed for character/still/video continuity (optional)
# AMP_PACKAGE_SEED=123456
# Gap between consecutive Google TTS API calls (seconds). Default 120 = 2 minutes.
# AMP_TTS_CALL_GAP_SEC=120
# TTS mode: continuous (one call/lang, best voice consistency) | per_shot
# AMP_TTS_MODE=continuous
# Free-tier soft rotate (never cross ~100%)
# AMP_API_ROTATE_AT=0.90
# AMP_API_HARD_CAP=0.95
# AMP_LOCALIZE_DAILY=40
# AMP_TTS_DAILY=60
# AMP_GROK_DAILY=50


# OpenRouter / Groq / Cerebras
OPENROUTER_API_KEY_1=
OPENROUTER_API_KEY_2=
GROQ_API_KEY_1=
CEREBRAS_API_KEY_1=

# xAI Grok — one key is auto-pinned for the whole custom-pipeline session
XAI_API_KEY_1=
XAI_API_KEY_2=
# GROK_API_KEY_1=   # alias
# GROK_MODEL=grok-3

# Agnes / Pollinations / media providers
AGNES_API_KEY_1=
AGNES_API_BASE_URL=
POLLINATIONS_API_KEY_1=
POLLINATIONS_BASE_URL=
POLLINATIONS_FREE_URL=

# Optional image/video providers
KLING_API_KEY_1=
LUMA_API_KEY_1=
SEEDANCE_API_KEY_1=
FREETHEAI_API_KEY_1=
GOBLIN_ENABLED=false

# Stock / research APIs
PEXELS_API_KEY_1=
PIXABAY_API_KEY_1=
HUGGINGFACE_API_KEY_1=

# Runtime paths (project-relative recommended)
STORAGE_BASE_DIR=
OUTPUT_BASE_DIR=
OUTPUT_VIDEOS_DIR=
OUTPUT_SUBTITLES_DIR=
OUTPUT_THUMBNAILS_DIR=

LOG_LEVEL=INFO
MAX_RETRIES=3
REQUEST_TIMEOUT=120
DEFAULT_LANGUAGE=en

# AMP_SKIP_* flags are ignored when INTELLIGENCE_MODE=PRODUCTION (H2).
# AMP_SKIP_LOCALIZE=1
# AMP_SKIP_ASSET_ARCHIVE=1
