      {
        "dialogue_id": "beat-5",
        "beat_id": "beat-5",
        "scene_id": "scene-04",
        "speaker": "Narrator",
        "text": "The implications of JWST's discoveries extend to future missions. What does this mean for our next steps in space exploration?",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
        "required_actions": [],
