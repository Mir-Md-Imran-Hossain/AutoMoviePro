      },
      {
        "dialogue_id": "beat-3",
        "beat_id": "beat-3",
        "scene_id": "scene-02",
        "speaker": "Narrator",
        "text": "JWST can identify gases like water vapor and carbon dioxide. This opens doors to understanding habitability on other planets. What gases can we find next?",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
