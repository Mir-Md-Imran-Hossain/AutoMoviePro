    "dialogue_segments": [
      {
        "dialogue_id": "beat-1",
        "beat_id": "beat-1",
        "scene_id": "scene-00",
        "speaker": "Narrator",
        "text": "What if I told you we can now fingerprint exoplanet atmospheres? This is the power of JWST's mid-infrared spectra.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
