      },
      {
        "dialogue_id": "beat-2",
        "beat_id": "beat-2",
        "scene_id": "scene-01",
        "speaker": "Narrator",
        "text": "JWST's mid-infrared spectra allow us to detect the chemical fingerprints of gases in exoplanet atmospheres. But how does this technology work?",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
