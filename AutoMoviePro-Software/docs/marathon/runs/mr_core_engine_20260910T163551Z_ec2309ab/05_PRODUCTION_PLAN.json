      {
        "dialogue_id": "beat-4",
        "beat_id": "beat-4",
        "scene_id": "scene-03",
        "speaker": "Narrator",
        "text": "These findings could reshape our search for extraterrestrial life. How does this affect our search for life beyond Earth?",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
        "required_actions": [],
