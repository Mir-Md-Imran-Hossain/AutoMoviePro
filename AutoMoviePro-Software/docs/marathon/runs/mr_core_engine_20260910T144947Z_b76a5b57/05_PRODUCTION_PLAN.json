      {
        "dialogue_id": "beat-4",
        "beat_id": "beat-4",
        "scene_id": "scene-03",
        "speaker": "Narrator",
        "text": "Gravity should slow this down. But something is overpowering it. This 'something' is what we call dark energy, a property of space itself.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
