      },
      {
        "dialogue_id": "beat-3",
        "beat_id": "beat-3",
        "scene_id": "scene-02",
        "speaker": "Narrator",
        "text": "Watch what this changes next — hydrogen acts like a molecular glass. It absorbs energy. Fast neutrons become slow. That change is the.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
        "required_actions": [],
