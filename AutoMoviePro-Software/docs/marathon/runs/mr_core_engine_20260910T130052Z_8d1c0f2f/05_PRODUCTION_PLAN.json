        "dialogue_id": "beat-1",
        "beat_id": "beat-1",
        "scene_id": "scene-00",
        "speaker": "Narrator",
        "text": "Most people miss this: the Moon isn't dry. It's hiding water in the dark, and we can see it without digging.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
