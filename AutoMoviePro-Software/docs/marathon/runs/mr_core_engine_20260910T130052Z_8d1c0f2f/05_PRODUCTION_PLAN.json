        "duration_sec": 9.0
      },
      {
        "dialogue_id": "beat-4",
        "beat_id": "beat-4",
        "scene_id": "scene-03",
        "speaker": "Narrator",
        "text": "What most viewers overlook next is this: we map this as albedo. Darker spots on the neutron map mean more hydrogen. And they.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
        "required_actions": [],
