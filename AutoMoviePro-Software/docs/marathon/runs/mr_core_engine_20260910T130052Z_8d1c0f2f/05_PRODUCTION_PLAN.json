      {
        "dialogue_id": "beat-2",
        "beat_id": "beat-2",
        "scene_id": "scene-01",
        "speaker": "Narrator",
        "text": "From that digging, cosmic rays hit the regolith constantly. They knock out neutrons. But if hydrogen is there, those neutrons slow down fast.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
