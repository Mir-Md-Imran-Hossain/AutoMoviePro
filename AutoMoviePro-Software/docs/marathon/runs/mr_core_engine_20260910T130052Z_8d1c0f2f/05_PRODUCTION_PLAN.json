        "start_sec": 26.75,
        "end_sec": 35.75,
        "duration_sec": 9.0
      },
      {
        "dialogue_id": "beat-5",
        "beat_id": "beat-5",
        "scene_id": "scene-04",
        "speaker": "Narrator",
        "text": "From that overlook, these are permanently shadowed regions. No sunlight. Temperatures drop to minus 250 Celsius. Water ice survives there for eons. So.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
