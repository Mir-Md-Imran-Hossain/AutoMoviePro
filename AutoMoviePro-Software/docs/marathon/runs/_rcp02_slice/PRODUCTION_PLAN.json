    {
      "dialogue_id": "beat-3",
      "beat_id": "beat-3",
      "scene_id": "scene-02",
      "speaker": "Narrator",
      "text": "These images show how early galaxies assembled from gas and dark matter after the Big Bang.",
      "emotion": "",
      "action": "",
