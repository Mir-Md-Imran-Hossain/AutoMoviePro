    {
      "dialogue_id": "beat-2",
      "beat_id": "beat-2",
      "scene_id": "scene-01",
      "speaker": "Narrator",
      "text": "Infrared deep-field images reveal galaxies that formed more than thirteen billion years ago.",
      "emotion": "",
      "action": "",
      "location": "deep space",
      "entities": [],
      "start_sec": 5.0,
