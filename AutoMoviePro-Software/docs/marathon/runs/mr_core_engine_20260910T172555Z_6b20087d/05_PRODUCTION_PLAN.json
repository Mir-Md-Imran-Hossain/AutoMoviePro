      },
      {
        "dialogue_id": "beat-2",
        "beat_id": "beat-2",
        "scene_id": "scene-01",
        "speaker": "Narrator",
        "text": "Visible light bounces off clouds. Mid-infrared penetrates dust. That's why we use it to find hidden molecules.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
        "required_actions": [],
