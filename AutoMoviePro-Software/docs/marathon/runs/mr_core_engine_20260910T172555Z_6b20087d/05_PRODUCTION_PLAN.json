        "duration_sec": 7.08
      },
      {
        "dialogue_id": "beat-3",
        "beat_id": "beat-3",
        "scene_id": "scene-02",
        "speaker": "Narrator",
        "text": "From that penetrates, watch what this changes next — carbon dioxide leaves a distinct dip at 4.3 microns. Methane shows up at 3.3. These are the fingerprints.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
        "required_actions": [],
        "required_location": "",
        "start_sec": 17.5,
        "end_sec": 28.5,
        "duration_sec": 11.0
      },
      {
        "dialogue_id": "beat-4",
        "beat_id": "beat-4",
        "scene_id": "scene-03",
        "speaker": "Narrator",
        "text": "But the star is a million times brighter. We subtract its light. What remains is the planet's breath.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
        "required_actions": [],
