    "dialogue_segments": [
      {
        "dialogue_id": "beat-1",
        "beat_id": "beat-1",
        "scene_id": "scene-00",
        "speaker": "Narrator",
        "text": "Most viewers miss this about JWST Mid-Infrared Spectra Exoplanet Atmospheres — most people miss this: we don't see exoplanets as dots. Stay for the evidence.",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
        "required_subject": "",
        "required_entities": [],
        "required_relationships": [],
