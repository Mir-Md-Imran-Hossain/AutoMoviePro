      {
        "dialogue_id": "beat-3",
        "beat_id": "beat-3",
        "scene_id": "scene-02",
        "speaker": "Narrator",
        "text": "Watch what this changes next — the MIRI instrument splits this light into a spectrum. Each gas absorbs specific wavelengths, creating dark dips..",
        "emotion": "",
        "action": "",
        "location": "",
        "entities": [],
