        "beat_id": "beat-1",
        "scene_id": "scene-00",
        "speaker": "Narrator",
        "text": "Why does JWST MIRI mid-infrared spectra fingerprinting exoplanet atmospheres matter right now? Most viewers miss this about JWST MIRI mid-infrared spectra fingerprinting exoplanet.",
        "emotion": "",
        "action": "",
        "location": "",
