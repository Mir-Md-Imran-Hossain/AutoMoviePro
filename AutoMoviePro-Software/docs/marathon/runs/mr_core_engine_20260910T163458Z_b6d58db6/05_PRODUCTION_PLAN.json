      {
        "dialogue_id": "beat-2",
        "beat_id": "beat-2",
        "scene_id": "scene-01",
        "speaker": "Narrator",
        "text": "Visible light bounces off clouds. But mid-infrared penetrates deeper. It hits the molecular glass of the atmosphere, revealing what's actually there.",
